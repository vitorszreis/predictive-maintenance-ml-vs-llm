# Copie este arquivo para ".env" e preencha. O .env está no .gitignore.

# Provedor da Etapa II: deepseek | zhipu | anthropic | openai_compatible | dummy
# Padrão do trabalho: deepseek. Use "dummy" para testar o pipeline offline e sem custo.
LLM_PROVIDER=deepseek

# Modelo (deixe vazio para usar o padrão do provedor):
#   deepseek  -> deepseek-chat
#   zhipu     -> glm-4-flash
#   anthropic -> claude-haiku-5-5
LLM_MODEL=

# Chave da DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Outras chaves (só se trocar de provedor)
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=

# Para openai_compatible (OpenRouter, Groq, Ollama local...)
LLM_API_KEY=
LLM_BASE_URL=

# Preço em USD por 1 milhão de tokens, para estimar o custo.
# Confira na página de preços do provedor no dia em que rodar e anote no relatório.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Opcionais
LLM_MAX_RETRIES=5
LLM_MAX_TOKENS=200
ANTHROPIC_EFFORT=low
